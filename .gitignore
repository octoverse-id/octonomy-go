# Compiled binaries and the example binary
/quickstart
examples/quickstart/quickstart
*.exe
*.test
*.out

# The contract gate is built to a temp directory and run from there (see the
# Makefile, which says why it is never `go run`). A stray `go build ./...` inside
# its own directory still leaves this behind -- and scripts/contract-identity.sh
# would then refuse it as a file main.pin does not classify.
/tools/contractdrift/contractdrift

# Coverage artifacts
coverage.out
coverage.html

# Go workspace files
go.work
go.work.sum

# Editor / OS noise
.idea/
.vscode/
.DS_Store

# Local environment
.env
.envrc

# Container harness credentials (scripts/octonomy-harness.sh writes a real
# service token here on every `make dev-server`)
.octonomy-harness.env

# Local code review pipeline artifacts (keep the tracked placeholder)
code-review/*
!code-review/.gitkeep
